# .env
# Application Settings
APP_NAME="AI Content Detector API"
APP_VERSION="1.0.0"
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# API Settings
API_PREFIX=/api/v1
ALLOWED_ORIGINS=*

# Security (generate your own secret key)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
